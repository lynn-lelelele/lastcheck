.guide {
  min-height: 100vh;
  background: #f7f4ee;
  color: #2e2b26;
  padding: 96rpx 48rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.logo {
  font-size: 72rpx;
  font-weight: 800;
  color: #b08968;
  letter-spacing: 2rpx;
}

.logo.done {
  color: #2e2b26;
}

.slogan {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #8c867b;
  line-height: 1.7;
}

.progress-row {
  display: flex;
  align-items: center;
  margin-bottom: 48rpx;
}

.progress-track {
  flex: 1;
  height: 18rpx;
  background: #e8e3d9;
  border-radius: 999rpx;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  background: #b08968;
  border-radius: 999rpx;
  transition: width 0.3s ease;
}

.progress-text {
  margin-left: 20rpx;
  font-size: 26rpx;
  font-weight: 800;
  color: #2e2b26;
}

.q-title {
  font-size: 44rpx;
  font-weight: 800;
  line-height: 1.5;
  margin-bottom: 48rpx;
  color: #2e2b26;
}

.option {
  background: #f7f4ee;
  border: 3rpx solid #e8e3d9;
  border-radius: 20rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  font-size: 32rpx;
  font-weight: 700;
  color: #2e2b26;
  box-shadow: 0 3rpx 0 #d9d9d9;
}

.option:active {
  background: #f3eee6;
  border-color: #b08968;
  opacity: 0.85;
}

.start-btn {
  margin-top: 48rpx;
}

.build {
  margin-top: 32rpx;
  text-align: center;
  font-size: 22rpx;
  color: #a8a29a;
}