.guide {
  min-height: 100vh;
  background: #1f1f1f;
  color: #ffffff;
  padding: 96rpx 48rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero {
  margin-bottom: 64rpx;
}

.logo {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 16rpx;
  font-size: 28rpx;
  color: #bdbdbd;
}

.steps {
  flex: 1;
}

.step {
  display: flex;
  align-items: flex-start;
  margin-bottom: 40rpx;
}

.step-no {
  width: 72rpx;
  height: 72rpx;
  border: 2rpx solid #4a4a4a;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 28rpx;
  color: #e0e0e0;
  margin-right: 24rpx;
  flex-shrink: 0;
}

.step-title {
  font-size: 34rpx;
  font-weight: 600;
}

.step-desc {
  margin-top: 8rpx;
  font-size: 26rpx;
  color: #bdbdbd;
  line-height: 1.6;
}

.start-btn {
  background: #ffffff;
  color: #1f1f1f;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
}

.start-btn::after {
  border: none;
}