.guide {
  min-height: 100vh;
  background: #1f1f1f;
  color: #ffffff;
  padding: 96rpx 48rpx 64rpx;
  box-sizing: border-box;
  display: flex;
  flex-direction: column;
}

.hero {
  flex: 1;
  display: flex;
  flex-direction: column;
  justify-content: center;
}

.logo {
  font-size: 64rpx;
  font-weight: 700;
  letter-spacing: 2rpx;
}

.slogan {
  margin-top: 24rpx;
  font-size: 30rpx;
  color: #bdbdbd;
  line-height: 1.7;
}

.progress {
  font-size: 24rpx;
  color: #8a8a8a;
  margin-bottom: 48rpx;
}

.q-title {
  font-size: 44rpx;
  font-weight: 600;
  line-height: 1.5;
  margin-bottom: 48rpx;
}

.option {
  background: #2a2a2a;
  border: 2rpx solid #3d3d3d;
  border-radius: 12rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  font-size: 30rpx;
}

.option:active {
  background: #333333;
}

.start-btn {
  background: #ffffff;
  color: #1f1f1f;
  border-radius: 12rpx;
  font-size: 32rpx;
  font-weight: 600;
  margin-top: 48rpx;
}

.start-btn::after {
  border: none;
}