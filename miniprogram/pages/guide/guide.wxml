<view class="guide">
  <!-- 欢迎页 -->
  <block wx:if="{{phase === 'welcome'}}">
    <view class="hero">
      <view class="logo">LastCheck</view>
      <view class="slogan">离开场所前，替你盯住要带的东西</view>
    </view>
    <button class="start-btn" bindtap="onStart">开始配置（约 1 分钟）</button>
  </block>

  <!-- 问卷页 -->
  <block wx:elif="{{phase === 'question'}}">
    <view class="progress">第 {{current + 1}} / {{total}} 步</view>
    <view class="q-title">{{question.title}}</view>
    <view class="options">
      <view
        class="option"
        wx:for="{{question.options}}"
        wx:key="key"
        data-key="{{item.key}}"
        bindtap="onPickOption"
      >{{item.label}}</view>
    </view>
  </block>

  <!-- 完成页 -->
  <block wx:else>
    <view class="hero">
      <view class="logo">配置完成</view>
      <view class="slogan">{{summary}}</view>
    </view>
    <button class="start-btn" bindtap="onDone">开始使用</button>
  </block>
</view>