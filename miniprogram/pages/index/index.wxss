.place-list {
  display: flex;
  flex-wrap: wrap;
}

.place-item {
  padding: 12rpx 28rpx;
  border: 3rpx solid #e5e5e5;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #4b4b4b;
  background: #ffffff;
}

.place-item.active {
  background: #58cc02;
  color: #ffffff;
  border-color: #58cc02;
  box-shadow: 0 3rpx 0 #46a302;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 3rpx solid #f0f0f0;
}

.item.done .item-name {
  text-decoration: line-through;
  color: #58cc02;
}

.item-status {
  font-size: 24rpx;
  font-weight: 800;
  color: #bdbdbd;
}

.item.done .item-status {
  color: #58cc02;
}

.leave-btn {
  margin-top: 8rpx;
}

.leave-tip {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  color: #4b4b4b;
}

.trigger-info {
  color: #ff4b4b;
  font-size: 28rpx;
  font-weight: 800;
}

.trigger-info.ok {
  color: #58cc02;
}

.btn-primary.ghost {
  background: #ffffff;
  color: #1cb0f6;
  border: 3rpx solid #1cb0f6;
  box-shadow: 0 3rpx 0 #0e8fc9;
}

.mock-notif {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #58cc02;
  color: #ffffff;
  padding: 24rpx 32rpx;
  transform: translateY(-120%);
  transition: transform 0.25s ease;
  box-shadow: 0 6rpx 20rpx rgba(70, 163, 2, 0.4);
}

.mock-notif.show {
  transform: translateY(0);
}

.mock-notif-title {
  font-size: 26rpx;
  font-weight: 800;
  opacity: 0.9;
}

.mock-notif-content {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}
.celebrate {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  text-align: center;
  pointer-events: none;
}

.celebrate-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #58cc02;
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 0 #46a302;
  animation: pop 0.5s ease;
}

.celebrate-text {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #58cc02;
}

@keyframes pop {
  0% { transform: scale(0.2); opacity: 0; }
  60% { transform: scale(1.15); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}