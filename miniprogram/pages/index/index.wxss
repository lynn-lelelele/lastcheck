.place-list {
  display: flex;
  flex-wrap: wrap;
}

.place-item {
  padding: 12rpx 28rpx;
  border: 2rpx solid #d9d9d9;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
}

.place-item.active {
  background: #1f1f1f;
  color: #ffffff;
  border-color: #1f1f1f;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 0;
  border-bottom: 2rpx solid #f0f0f0;
}

.item.done .item-name {
  text-decoration: line-through;
  color: #8a8a8a;
}

.item-status {
  font-size: 24rpx;
  color: #8a8a8a;
}

.leave-btn {
  margin-top: 8rpx;
}

.leave-tip {
  font-size: 26rpx;
  margin-bottom: 8rpx;
}

.trigger-info {
  color: #c0392b;
  font-size: 28rpx;
  font-weight: 600;
}

.trigger-info.ok {
  color: #2e7d32;
}
.debug-bar {
  background: #2a2a2a;
  color: #e0e0e0;
  font-size: 20rpx;
  padding: 8rpx 16rpx;
  border-radius: 8rpx;
  margin-bottom: 16rpx;
  word-break: break-all;
}
.btn-primary.ghost {
  background: #ffffff;
  color: #1f1f1f;
  border: 2rpx solid #1f1f1f;
  margin-top: 16rpx;
}
.mock-notif {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #1f1f1f;
  color: #ffffff;
  padding: 24rpx 32rpx;
  transform: translateY(-120%);
  transition: transform 0.25s ease;
  box-shadow: 0 4rpx 16rpx rgba(0, 0, 0, 0.25);
}

.mock-notif.show {
  transform: translateY(0);
}

.mock-notif-title {
  font-size: 26rpx;
  color: #bdbdbd;
}

.mock-notif-content {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 600;
}