.place-list {
  display: flex;
  flex-wrap: wrap;
}

.place-item {
  padding: 12rpx 28rpx;
  border: 3rpx solid #e8e3d9;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #2e2b26;
  background: #f7f4ee;
}

.place-item.active {
  background: rgba(46, 43, 38, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  color: #ffffff;
  border-color: #b08968;
  box-shadow: 0 3rpx 0 #8a6d4b;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 3rpx solid #efe9df;
}

.item.done .item-name {
  text-decoration: line-through;
  color: #b08968;
}

.item-status {
  font-size: 24rpx;
  font-weight: 800;
  color: #a8a29a;
}

.item.done .item-status {
  color: #b08968;
}

.leave-btn {
  margin-top: 8rpx;
}

.leave-tip {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  color: #2e2b26;
}

.trigger-info {
  color: #a25e4c;
  font-size: 28rpx;
  font-weight: 800;
}

.trigger-info.ok {
  color: #b08968;
}

.btn-primary.ghost {
  background: #f7f4ee;
  color: #b08968;
  border: 3rpx solid #b08968;
  box-shadow: 0 3rpx 0 #8a6d4b;
}

.mock-notif {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: rgba(46, 43, 38, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  color: #ffffff;
  padding: 24rpx 32rpx;
  opacity: 0;
  transition: opacity 0.35s ease;
  box-shadow: 0 6rpx 20rpx rgba(70, 163, 2, 0.4);
}

.mock-notif.show {
  opacity: 1;
}

.mock-notif-title {
  font-size: 26rpx;
  font-weight: 800;
  opacity: 0.9;
}

.mock-notif-content {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}
.celebrate {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  text-align: center;
  pointer-events: none;
}

.celebrate-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: rgba(46, 43, 38, 0.72);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 0 #8a6d4b;
  animation: pop 0.4s ease-out;
}

.celebrate-text {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #b08968;
}

@keyframes pop {
  0% { transform: scale(0.9); opacity: 0; }
  60% { transform: scale(1.03); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}

.item:active {
  background: rgba(46, 43, 38, 0.04);
  border-radius: 12rpx;
  transition: background 0.15s ease;
}

.place-item:active {
  opacity: 0.7;
}

.item {
  animation: fadeInUp 0.3s ease-out both;
}

@keyframes fadeInUp {
  from { opacity: 0; transform: translateY(8rpx); }
  to { opacity: 1; transform: translateY(0); }
}

.check-dot {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  border: 3rpx solid #b08968;
  display: flex;
  align-items: center;
  justify-content: center;
  transition: background 0.2s ease, border-color 0.2s ease;
  flex-shrink: 0;
}

.check-dot.checked {
  background: #b08968;
  border-color: #b08968;
}

.check-mark {
  color: #ffffff;
  font-size: 24rpx;
  font-weight: 700;
}

.item:active {
  background: rgba(176, 137, 104, 0.08);
  border-radius: 12rpx;
}

.empty-card {
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  display: block;
  opacity: 0.55;
}

.card-head {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.edit-btn {
  font-size: 26rpx;
  color: #b08968;
  font-weight: 600;
  padding: 8rpx 16rpx;
}

.item-right {
  display: flex;
  align-items: center;
}

.remove-x {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(162, 94, 76, 0.1);
  color: #a25e4c;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.add-row {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.add-input {
  flex: 1;
  border: 3rpx solid #e8e3d9;
  border-radius: 12rpx;
  padding: 16rpx 20rpx;
  font-size: 28rpx;
  margin-right: 16rpx;
}

.add-btn {
  margin-top: 0;
  padding: 0 32rpx;
}
