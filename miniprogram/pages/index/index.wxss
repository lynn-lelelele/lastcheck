.place-list {
  display: flex;
  flex-wrap: wrap;
}

.place-item {
  padding: 12rpx 28rpx;
  border: 3rpx solid #e8e3d9;
  border-radius: 999rpx;
  margin: 0 16rpx 16rpx 0;
  font-size: 26rpx;
  font-weight: 700;
  color: #2e2b26;
  background: #f7f4ee;
}

.place-item.active {
  background: #b08968;
  color: #ffffff;
  border-color: #b08968;
  box-shadow: 0 3rpx 0 #8a6d4b;
}

.item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 26rpx 0;
  border-bottom: 3rpx solid #efe9df;
}

.item.done .item-name {
  text-decoration: line-through;
  color: #b08968;
}

.item-status {
  font-size: 24rpx;
  font-weight: 800;
  color: #a8a29a;
}

.item.done .item-status {
  color: #b08968;
}

.leave-btn {
  margin-top: 8rpx;
}

.leave-tip {
  font-size: 26rpx;
  margin-bottom: 8rpx;
  color: #2e2b26;
}

.trigger-info {
  color: #a25e4c;
  font-size: 28rpx;
  font-weight: 800;
}

.trigger-info.ok {
  color: #b08968;
}

.btn-primary.ghost {
  background: #f7f4ee;
  color: #b08968;
  border: 3rpx solid #b08968;
  box-shadow: 0 3rpx 0 #8a6d4b;
}

.mock-notif {
  position: fixed;
  top: 0;
  left: 0;
  right: 0;
  z-index: 999;
  background: #b08968;
  color: #ffffff;
  padding: 24rpx 32rpx;
  opacity: 0;
  transition: opacity 0.35s ease;
  box-shadow: 0 6rpx 20rpx rgba(70, 163, 2, 0.4);
}

.mock-notif.show {
  opacity: 1;
}

.mock-notif-title {
  font-size: 26rpx;
  font-weight: 800;
  opacity: 0.9;
}

.mock-notif-content {
  margin-top: 6rpx;
  font-size: 28rpx;
  font-weight: 800;
}
.celebrate {
  position: fixed;
  top: 40%;
  left: 50%;
  transform: translate(-50%, -50%);
  z-index: 1000;
  text-align: center;
  pointer-events: none;
}

.celebrate-badge {
  width: 160rpx;
  height: 160rpx;
  border-radius: 50%;
  background: #b08968;
  color: #ffffff;
  font-size: 80rpx;
  font-weight: 800;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto;
  box-shadow: 0 8rpx 0 #8a6d4b;
  animation: pop 0.4s ease-out;
}

.celebrate-text {
  margin-top: 24rpx;
  font-size: 34rpx;
  font-weight: 800;
  color: #b08968;
}

@keyframes pop {
  0% { transform: scale(0.9); opacity: 0; }
  60% { transform: scale(1.03); opacity: 1; }
  100% { transform: scale(1); opacity: 1; }
}
