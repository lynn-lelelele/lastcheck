<view class="container">
<view class="mock-notif {{mockNotif.visible ? 'show' : ''}}">
  <view class="mock-notif-title">{{mockNotif.title}}</view>
  <view class="mock-notif-content">{{mockNotif.content}}</view>
</view>
  <view class="card" wx:if="{{places.length}}">
    <view class="card-title">当前场所</view>
    <view class="place-list">
      <view
        wx:for="{{places}}"
        wx:key="id"
        class="place-item {{item.id === currentPlaceId ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSwitchPlace"
      >{{item.name}}</view>
    </view>
  </view>

  <view class="card" wx:if="{{currentPlace}}">
    <view class="card-title">出门清单</view>
    <view wx:if="{{items.length === 0}}" class="muted">该场所还没有物品。</view>
    <button class="btn-primary ghost" wx:if="{{items.length === 0}}" bindtap="goTemplates">看看常用清单</button>
    <view
      wx:for="{{items}}"
      wx:key="*this"
      class="item {{checkedMap[index] ? 'done' : ''}}"
      data-index="{{index}}"
      bindtap="onToggleItem"
    >
      <text class="item-name">{{item}}</text>
      <text class="item-status">{{checkedMap[index] ? '已带' : '未确认'}}</text>
    </view>
    <button class="btn-primary" bindtap="onCheckAll" wx:if="{{items.length}}">全部确认已带</button>
  </view>

  <view class="card" wx:if="{{currentPlace && items.length}}">
    <button class="btn-primary leave-btn" bindtap="onManualLeave">我出门了</button>
  </view>

  <view class="card" wx:if="{{showLeaveCard}}">
    <view class="card-title">出门提醒</view>
    <view class="leave-tip">离开「{{currentPlace.name}}」前请确认以下物品</view>
    <view class="trigger-info {{triggerOk ? 'ok' : ''}}">{{triggerInfo}}</view>
  </view>

  <view class="card" wx:if="{{!currentPlace}}">
    <view class="card-title">还没有场所</view>
    <view class="muted">先去「场所」添加家或公司，再到「常用」选用一份清单。</view>
    <button class="btn-primary" bindtap="goPlaces">去添加场所</button>
    <button class="btn-primary ghost" bindtap="goTemplates">看看常用清单</button>
  </view>
</view>