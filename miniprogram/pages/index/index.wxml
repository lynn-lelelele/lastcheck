<view class="celebrate" wx:if="{{celebration}}">
  <view class="celebrate-badge">✓</view>
  <view class="celebrate-text">全部带齐</view>
</view>
<view class="container">
<view class="mock-notif {{mockNotif.visible ? 'show' : ''}}">
  <view class="mock-notif-title">{{mockNotif.title}}</view>
  <view class="mock-notif-content">{{mockNotif.content}}</view>
</view>
  <view class="card" wx:if="{{currentPlace}}">
    <view class="place-list" wx:if="{{places.length > 1}}">
      <view
        wx:for="{{places}}"
        wx:key="id"
        class="place-item {{item.id === currentPlaceId ? 'active' : ''}}"
        data-id="{{item.id}}"
        bindtap="onSwitchPlace"
      >{{item.name}}</view>
    </view>
    <view class="card-title">出门清单</view>
    <view wx:if="{{items.length === 0}}" class="muted">这里还没有物品。</view>
    <button class="btn-primary ghost" wx:if="{{items.length === 0}}" bindtap="goTemplates">看看常用清单</button>
    <view
      wx:for="{{items}}"
      wx:key="*this"
      class="item {{checkedMap[index] ? 'done' : ''}}"
      data-index="{{index}}"
      bindtap="onToggleItem"
      style="animation-delay: {{index * 40}}ms"
    >
      <text class="item-name">{{item}}</text>
      <view class="check-dot {{checkedMap[index] ? 'checked' : ''}}">
        <text class="check-mark" wx:if="{{checkedMap[index]}}">✓</text>
      </view>
    </view>
    <button class="btn-primary" bindtap="onCheckAll" wx:if="{{items.length}}">全部确认已带</button>
  </view>

  <view class="card" wx:if="{{showLeaveCard}}">
    <view class="card-title">出门提醒</view>
    <view class="leave-tip">离开「{{currentPlace.name}}」前请确认以下物品</view>
    <view class="trigger-info {{triggerOk ? 'ok' : ''}}">{{triggerInfo}}</view>
  </view>

  <view class="card empty-card" wx:if="{{!currentPlace}}">
    <image class="empty-icon" src="/images/tab/checklist.png" mode="aspectFit"></image>
    <view class="card-title">还没有常去的地方</view>
    <view class="muted">添加常去的地方，再到「常用」选用一份出门清单。</view>
    <button class="btn-primary" bindtap="goPlaces">添加常去的地方</button>
    <button class="btn-secondary" bindtap="goTemplates">看看常用清单</button>
  </view>
</view>