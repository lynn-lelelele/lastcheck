<view class="container">
  <button class="btn-primary add-btn" bindtap="onAddPlace">添加常去的地方</button>

  <view class="card" wx:for="{{places}}" wx:key="id">
    <view class="place-row">
      <view>
        <view class="card-title">{{item.name}}</view>
        <view class="muted addr" data-id="{{item.id}}" bindtap="onOpenLocation">{{item.address}} ›</view>
      </view>
      <view class="radius" data-id="{{item.id}}" bindtap="onEditRadius">半径 {{item.radius}}m</view>
    </view>
    <view class="muted item-count">{{item.items.length}} 件物品</view>
    <view class="remove" data-id="{{item.id}}" bindtap="onRemovePlace">删除</view>
  </view>

  <view class="card empty-card" wx:if="{{places.length === 0}}">
    <image class="empty-icon" src="/images/tab/place.png" mode="aspectFit"></image>
    <view class="card-title">还没有常去的地方</view>
    <view class="muted">添加家或公司，离开时会自动提醒你。</view>
  </view>
</view>