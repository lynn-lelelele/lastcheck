.add-btn {
  margin-bottom: 24rpx;
}

.place-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.radius {
  color: #b08968;
  border: 3rpx solid #b08968;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  background: #f7f4ee;
}

.item-count {
  margin-top: 8rpx;
}

.remove {
  margin-top: 16rpx;
  color: #a25e4c;
  font-size: 26rpx;
  font-weight: 800;
}
.empty-card {
  text-align: center;
}

.empty-icon {
  width: 120rpx;
  height: 120rpx;
  margin: 0 auto 16rpx;
  display: block;
  opacity: 0.55;
}
