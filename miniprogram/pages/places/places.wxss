.add-btn {
  margin-bottom: 24rpx;
}

.place-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.radius {
  color: #1cb0f6;
  border: 3rpx solid #1cb0f6;
  border-radius: 999rpx;
  padding: 6rpx 20rpx;
  font-size: 24rpx;
  font-weight: 800;
  background: #ffffff;
}

.item-count {
  margin-top: 8rpx;
}

.remove {
  margin-top: 16rpx;
  color: #ff4b4b;
  font-size: 26rpx;
  font-weight: 800;
}