.apply-btn {
  margin-top: 12rpx;
}

.tags {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 8rpx;
}

.tag {
  background: #f0e9dc;
  color: #8a6d4b;
  border-radius: 999rpx;
  padding: 8rpx 20rpx;
  margin: 0 12rpx 12rpx 0;
  font-size: 24rpx;
  font-weight: 600;
}

.note {
  text-align: center;
}

.custom-item {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #efe9df;
}

.custom-item:last-child {
  border-bottom: none;
}

.custom-row {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.custom-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2e2b26;
}

.remove-x {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: rgba(162, 94, 76, 0.1);
  color: #a25e4c;
  font-size: 32rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.preset {
  padding: 20rpx 0;
  border-bottom: 2rpx solid #efe9df;
}

.preset:last-child {
  border-bottom: none;
}

.preset-name {
  font-size: 32rpx;
  font-weight: 700;
  color: #2e2b26;
  margin-bottom: 12rpx;
}
