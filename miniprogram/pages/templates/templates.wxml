<view class="container">
  <view class="card">
    <view class="card-title">出门清单</view>
    <view class="muted">选一份现成的，或新建自己的清单，用到常去的地方。</view>
    <button class="btn-primary apply-btn" bindtap="onNewTemplate">新建我的清单</button>
  </view>

  <view class="card" wx:if="{{customList.length}}">
    <view class="card-title">我的清单</view>
    <view class="custom-item" wx:for="{{customList}}" wx:key="id">
      <view class="custom-row">
        <view class="custom-info">
          <view class="custom-name">{{item.name}}</view>
          <view class="muted">{{item.items.length}} 件物品</view>
        </view>
        <view class="remove-x" data-id="{{item.id}}" bindtap="onRemoveCustom">×</view>
      </view>
      <button class="btn-primary apply-btn" data-custom="{{item.id}}" bindtap="onUse">用到地点</button>
    </view>
  </view>

  <view class="card">
    <view class="card-title">现成清单</view>
    <view class="preset" wx:for="{{presetsList}}" wx:key="key">
      <view class="preset-name">{{item.label}}</view>
      <view class="tags">
        <text class="tag" wx:for="{{item.items}}" wx:for-item="it" wx:key="*this">{{it}}</text>
      </view>
      <button class="btn-primary apply-btn" data-key="{{item.key}}" bindtap="onUse">用到地点</button>
    </view>
  </view>
  <view class="muted note">清单内容来自社区共建，欢迎在 GitHub 提交更多。</view>
</view>
