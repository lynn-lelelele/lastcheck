.tab-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  height: 120rpx;
  padding-bottom: env(safe-area-inset-bottom);
  background: rgba(250, 248, 242, 0.96);
  backdrop-filter: blur(20rpx);
  -webkit-backdrop-filter: blur(20rpx);
  border-top: 2rpx solid #efe9df;
  display: flex;
  z-index: 999;
}

.tab-item {
  flex: 1;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  position: relative;
}

/* 选中胶囊背景 */
.tab-bg {
  position: absolute;
  top: 8rpx;
  left: 50%;
  margin-left: -54rpx;
  width: 108rpx;
  height: 68rpx;
  border-radius: 34rpx;
  background: rgba(176, 137, 104, 0.2);
  opacity: 0;
  transform: scale(0.6);
  transition: opacity 0.45s ease, transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

.tab-bg.show {
  opacity: 1;
  transform: scale(1);
}

.tab-icon {
  width: 44rpx;
  height: 44rpx;
  position: relative;
  transition: transform 0.45s cubic-bezier(0.34, 1.56, 0.64, 1);
}

/* 选中：图标放大 + 上浮 */
.tab-item.active .tab-icon {
  transform: translateY(-10rpx) scale(1.5);
}



.tab-text {
  font-size: 20rpx;
  color: #9a938a;
  margin-top: 6rpx;
  position: relative;
  transition: color 0.3s ease;
}

.tab-item.active .tab-text {
  color: #b08968;
  font-weight: 700;
}

/* 果冻：先冲大再回缩 */
.tab-icon.bounce {
  animation: jelly 0.55s ease;
}

@keyframes jelly {
  0% { transform: translateY(-10rpx) scale(1.5); }
  30% { transform: translateY(-18rpx) scale(1.9); }
  50% { transform: translateY(-8rpx) scale(1.25); }
  70% { transform: translateY(-13rpx) scale(1.65); }
  85% { transform: translateY(-9rpx) scale(1.42); }
  100% { transform: translateY(-10rpx) scale(1.5); }
}
