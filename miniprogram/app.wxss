page {
  background: #ffffff;
  color: #4b4b4b;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
}

.card {
  background: #ffffff;
  border: 3rpx solid #e5e5e5;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 4rpx 12rpx rgba(75, 75, 75, 0.08);
}

.card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #4b4b4b;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #58cc02;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 5rpx 0 #46a302;
  margin-top: 16rpx;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  transform: translateY(3rpx);
  box-shadow: 0 2rpx 0 #46a302;
}

.btn-secondary {
  background: #ffffff;
  color: #1cb0f6;
  border: 3rpx solid #1cb0f6;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: #ddf4ff;
}

.muted {
  color: #8a8a8a;
  font-size: 26rpx;
}