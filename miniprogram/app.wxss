page {
  background: #f7f4ee;
  color: #2e2b26;
  font-size: 28rpx;
  line-height: 1.6;
}

.container {
  padding: 32rpx;
}

.card {
  background: #f7f4ee;
  border: 3rpx solid #e8e3d9;
  border-radius: 24rpx;
  padding: 32rpx;
  margin-bottom: 24rpx;
  box-shadow: 0 2rpx 10rpx rgba(46, 43, 38, 0.06);
}

.card-title {
  font-size: 34rpx;
  font-weight: 800;
  color: #2e2b26;
  margin-bottom: 16rpx;
}

.btn-primary {
  background: #b08968;
  color: #ffffff;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  box-shadow: 0 2rpx 10rpx rgba(46, 43, 38, 0.18);
  margin-top: 16rpx;
  transition: transform 0.1s ease, box-shadow 0.1s ease;
}

.btn-primary::after {
  border: none;
}

.btn-primary:active {
  opacity: 0.85;
  box-shadow: 0 2rpx 0 #8a6d4b;
}

.btn-secondary {
  background: #f7f4ee;
  color: #b08968;
  border: 3rpx solid #b08968;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 800;
  margin-top: 16rpx;
}

.btn-secondary::after {
  border: none;
}

.btn-secondary:active {
  background: #ddf4ff;
}

.muted {
  color: #8c867b;
  font-size: 26rpx;
}